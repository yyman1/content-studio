# Plaid credentials — get from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_sandbox_or_production_secret_here

# sandbox | development | production
PLAID_ENV=sandbox

# Comma-separated access tokens, one per institution
# e.g. access-sandbox-abc123,access-sandbox-def456
PLAID_ACCESS_TOKENS=access-sandbox-placeholder

# Transport: stdio (for Claude Desktop) | http (for remote/Claude.ai)
MCP_TRANSPORT=stdio

# Only used when MCP_TRANSPORT=http
PORT=3100
